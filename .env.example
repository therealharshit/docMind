APP_NAME="Intelligent Document Ingestion System"
APP_ENV=development
LOG_LEVEL=INFO

STORAGE_DIR=storage
DATABASE_URL=sqlite:///storage/app.db
MAX_UPLOAD_MB=100

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_NUM_PARALLEL=1

# LLM provider: "ollama" (local, default) or "google" (cloud)
LLM_PROVIDER=ollama
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

PIPELINE_MODE=fast
FAST_MODE_MAX_CHARS=18000
QUALITY_MODE_MAX_CHARS=60000
WORKER_POLL_SECONDS=1
